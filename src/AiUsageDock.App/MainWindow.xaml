<Window x:Class="AiUsageDock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AI Usage Dock"
        Width="428" Height="46"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#1E1E22"
        Foreground="#E6EDF3"
        FontFamily="Segoe UI, Malgun Gothic"
        Cursor="Hand"
        MouseLeftButtonUp="OnDockLeftClick"
        MouseRightButtonUp="OnDockRightClick">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="새로고침" Click="OnMenuRefreshClick"/>
            <MenuItem Header="설정..." Click="OnMenuSettingsClick"/>
            <MenuItem Header="종료" Click="OnMenuExitClick"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Border x:Name="DockBorder"
            BorderBrush="#38383F"
            BorderThickness="1"
            CornerRadius="8"
            Background="#1E1E22"
            Padding="8,5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92"/>
                <ColumnDefinition Width="98"/>
                <ColumnDefinition Width="98"/>
                <ColumnDefinition Width="98"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5" Fill="#4D6BFE" Margin="0,0,4,0"/>
                    <TextBlock Text="DeepSeek" FontSize="9.5" Foreground="#8B949E"/>
                </StackPanel>
                <TextBlock x:Name="DeepSeekValueText"
                           Text="$--.--"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="#E6EDF3"
                           Margin="0,1,0,0"/>
            </StackPanel>

            <Grid Grid.Column="1">
                <Border Width="1" Background="#38383F" HorizontalAlignment="Left" Margin="0,2"/>
                <StackPanel Margin="7,0,3,0" VerticalAlignment="Center">
                    <TextBlock x:Name="Tile1Label" Text="Antigravity 1" FontSize="9.5" Foreground="#8B949E" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="Tile1Value" Text="--" FontSize="11.5" FontWeight="Bold" Foreground="#E6EDF3"/>
                    <ProgressBar x:Name="Tile1Bar" Height="2.5" Minimum="0" Maximum="100" Background="#30363D" Foreground="#3FB950" BorderThickness="0" Value="0" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="2">
                <Border Width="1" Background="#38383F" HorizontalAlignment="Left" Margin="0,2"/>
                <StackPanel Margin="7,0,3,0" VerticalAlignment="Center">
                    <TextBlock x:Name="Tile2Label" Text="Antigravity 2" FontSize="9.5" Foreground="#8B949E" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="Tile2Value" Text="--" FontSize="11.5" FontWeight="Bold" Foreground="#E6EDF3"/>
                    <ProgressBar x:Name="Tile2Bar" Height="2.5" Minimum="0" Maximum="100" Background="#30363D" Foreground="#3FB950" BorderThickness="0" Value="0" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="3">
                <Border Width="1" Background="#38383F" HorizontalAlignment="Left" Margin="0,2"/>
                <StackPanel Margin="7,0,3,0" VerticalAlignment="Center">
                    <TextBlock x:Name="Tile3Label" Text="Antigravity 3" FontSize="9.5" Foreground="#8B949E" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="Tile3Value" Text="--" FontSize="11.5" FontWeight="Bold" Foreground="#E6EDF3"/>
                    <ProgressBar x:Name="Tile3Bar" Height="2.5" Minimum="0" Maximum="100" Background="#30363D" Foreground="#3FB950" BorderThickness="0" Value="0" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="4">
                <TextBlock x:Name="ErrorBangText"
                           Text="!"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#F85149"
                           Visibility="Collapsed"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                <Ellipse x:Name="StatusDot"
                         Width="6"
                         Height="6"
                         Fill="#3FB950"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"
                         Margin="0,2,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
