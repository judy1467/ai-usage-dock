<Window x:Class="AiUsageDock.App.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 사용량"
        Width="430" Height="520"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#18181C"
        FontFamily="Segoe UI, Malgun Gothic"
        Foreground="#E6EDF3">
    <Window.Resources>
        <Style x:Key="FlatLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#8B949E" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#38383F" BorderThickness="1" Background="#18181C" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: title left, text actions right -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="AI 사용량" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton"
                            Content="새로고침"
                            Click="OnRefreshClick"
                            Style="{StaticResource FlatLink}"
                            Margin="0,0,12,0" />
                    <Button x:Name="MoreButton"
                            Content="⋯"
                            Click="OnMoreClick"
                            Style="{StaticResource FlatLink}"
                            FontSize="16"
                            Padding="4,0,2,4">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="설정..." Click="OnSettingsClick" />
                                <MenuItem Header="종료" Click="OnExitClick" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- DeepSeek -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="DEEPSEEK API" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="#6E7681" Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="DeepSeekBalanceText" Text="$--.--" FontSize="29" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="DeepSeekBadgeText" Text="사용 가능" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#3FB950" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="DeepSeekDetailText" Text="충전 $0.00 · 보너스 $0.00 · USD"
                                   FontSize="12" Foreground="#8B949E" Margin="0,4,0,0" />
                        <TextBlock x:Name="DeepSeekSpendText" Text="오늘 사용 -$0.00 (추정)"
                                   FontSize="12" Foreground="#D29922" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Canvas x:Name="SparkCanvas" Width="148" Height="50" HorizontalAlignment="Right" />
                        <TextBlock Text="최근 7일 잔액" FontSize="10" Foreground="#6E7681"
                                   HorizontalAlignment="Right" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <Border BorderBrush="#2A2A31" BorderThickness="0,1,0,0" Margin="0,14,0,12" />
            </StackPanel>

            <!-- Antigravity -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ANTIGRAVITY" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="#6E7681" VerticalAlignment="Center" />
                        <Border Background="#21262D" BorderBrush="#38383F" BorderThickness="1"
                                CornerRadius="4" Padding="5,0" Margin="8,0,0,0">
                            <TextBlock x:Name="PlanBadgeText" Text="Pro" FontSize="10.5" Foreground="#58A6FF" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse x:Name="AgStatusDot" Width="7" Height="7" Fill="#3FB950"
                                 VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock x:Name="AgStatusText" Text="앱 실행 중 · 30초 주기"
                                   FontSize="10.5" Foreground="#8B949E" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ModelsPanel" />
                </ScrollViewer>
            </Grid>

            <!-- Footer -->
            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                <Border BorderBrush="#2A2A31" BorderThickness="0,1,0,0" Margin="0,0,0,8" />
                <TextBlock x:Name="SummaryText" Text="모델 0개 · 쿼터 그룹 0개 · 5시간/주간 리셋"
                           FontSize="10.5" Foreground="#8B949E" />
                <TextBlock x:Name="HintText" Text="행 클릭: 작업표시줄 고정/해제 (최대 3개)"
                           FontSize="10.5" Foreground="#6E7681" Margin="0,3,0,0" />
                <TextBlock x:Name="FooterText" Text="마지막 갱신 --:--:-- · 자동 30초/5분 · v1.0"
                           FontSize="10.5" Foreground="#6E7681" Margin="0,3,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
